version: v1.5.0
ignore:
  SNYK-JS-ZOD-20510278:
    - '*':
        reason: >
          Aucune version corrigée de zod n'existe à ce jour (toutes versions
          affectées). La faille ne concerne que les schémas z.array() sans
          contrainte de longueur ; le projet n'en utilise aucun (schémas
          objets/chaînes/nombres uniquement). Ajouter .max() à tout futur
          z.array(). À réévaluer à l'expiration ou dès qu'un correctif sort.
        expires: 2026-12-31T00:00:00.000Z
